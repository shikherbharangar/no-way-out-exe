# Frontend: public URL, never a credential. Required for deployed online co-op.
# Build the frontend after setting this; Vite embeds VITE_* at build time.
VITE_SERVER_URL=wss://YOUR-ACTUAL-RENDER-SERVICE.onrender.com

# Backend runtime variables. No secrets are required for this private-room slice.
# Render injects PORT automatically. This value is for local development only.
PORT=2567
# Comma-separated exact browser origins; configure on the backend in production.
ALLOWED_ORIGIN=https://YOUR-ACTUAL-VERCEL-PROJECT.vercel.app
# Render sets this via render.yaml; do not set production for an unconfigured local server.
# NODE_ENV=production
