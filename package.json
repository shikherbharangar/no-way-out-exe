{
  "name": "no-way-out-exe",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:browser": "node scripts/smoke.mjs",
    "assets": "python scripts/make_assets.py",
    "server": "tsx server/index.ts",
    "test:network": "node scripts/network-test.mjs",
    "inspect": "node scripts/inspect.mjs",
    "test:network:action": "node scripts/network-action-test.mjs",
    "capture:showcase": "node scripts/showcase.mjs",
    "capture:gameplay": "node scripts/capture-gameplay.mjs",
    "export:showcase": "node scripts/export-showcase.mjs",
    "test:production": "node scripts/production-test.mjs",
    "test:network:machine": "tsx scripts/machine-network.ts",
    "test:browser:machine": "node scripts/machine-browser.mjs",
    "capture:machine": "node scripts/machine-browser.mjs",
    "test:browser:machine:online": "node scripts/machine-online-browser.mjs",
    "export:machine": "node scripts/export-machine.mjs",
    "assets:supplied": "python scripts/import-supplied.py",
    "test:art": "node scripts/test-supplied-render.mjs",
    "capture:supplied": "node scripts/capture-supplied.mjs",
    "verify:supplied": "python scripts/verify-supplied.py",
    "art:prepare-animation": "python scripts/prepare-animation-production.py",
    "art:audit-animation": "python scripts/audit-animation-production.py",
    "capture:animation-review": "node scripts/capture-animation-review.mjs",
    "test:animation-gallery": "node scripts/review-animation.mjs",
    "test:deployed": "node scripts/deployed-browser.mjs"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "phaser": "3.90.0",
    "tsx": "4.20.6",
    "ws": "8.18.3"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "22.18.6",
    "@types/ws": "8.18.1",
    "typescript": "5.9.3",
    "vite": "7.1.12",
    "vitest": "3.2.4"
  },
  "engines": {
    "node": ">=22.12"
  }
}
