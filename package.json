{
  "name": "no-way-out-exe",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:browser": "node scripts/smoke.mjs",
    "assets": "python scripts/make_assets.py",
    "server": "tsx server/index.ts",
    "test:network": "node scripts/network-test.mjs",
    "inspect": "node scripts/inspect.mjs"
  },
  "dependencies": {
    "phaser": "3.90.0",
    "ws": "8.18.3",
    "tsx": "4.20.6"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "22.18.6",
    "@types/ws": "8.18.1",
    "typescript": "5.9.3",
    "vite": "7.1.12",
    "vitest": "3.2.4"
  },
  "engines": {
    "node": ">=22.12"
  }
}
